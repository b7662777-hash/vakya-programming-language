# Auto normalize line endings to LF across all platforms
* text=auto eol=lf

# Explicitly maintain CRLF for Windows PowerShell and batch scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicitly maintain LF for Unix shell scripts
*.sh text eol=lf

# Binary file declarations
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.zip binary
*.7z binary
*.tar.gz binary
